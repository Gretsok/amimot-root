# Postgres
POSTGRES_USER=amimot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=amimot
DATABASE_URL=postgresql://amimot:changeme@postgres:5432/amimot

# Backend
JWT_SECRET=changeme
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback

# Frontend — mode DEV uniquement (docker-compose.override.yml, serveur Vite) :
# port publié sur l'hôte pour le hot-reload.
FRONTEND_PORT=5173

# Frontend — mode PROD (docker-compose.yml seul, Caddy) :
# - En local/VPS sans nom de domaine : laisser les valeurs par défaut
#   (DOMAIN=localhost, TLS_MODE=internal) → certificat auto-signé.
# - Sur un vrai VPS avec domaine (ex: OVH) : pointer un enregistrement DNS A
#   vers l'IP du VPS, ouvrir les ports 80 et 443, puis renseigner :
#     DOMAIN=ton-domaine.fr
#     TLS_MODE=ton-email@example.com   (email de contact Let's Encrypt)
#   Caddy obtient et renouvelle alors le certificat automatiquement.
DOMAIN=localhost
TLS_MODE=internal
HTTP_PORT=80
HTTPS_PORT=443
