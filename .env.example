# Postgres
POSTGRES_USER=amimot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=amimot
DATABASE_URL=postgresql://amimot:changeme@postgres:5432/amimot

# Backend
JWT_SECRET=changeme
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback

# Frontend — mode DEV uniquement (docker-compose.override.yml, serveur Vite) :
# port publié sur l'hôte pour le hot-reload.
FRONTEND_PORT=5173

# Frontend — mode PROD (docker-compose.yml seul, Caddy) :
# - En local/VPS sans nom de domaine : laisser les valeurs par défaut
#   (DOMAIN=localhost, TLS_MODE=internal) → certificat auto-signé.
# - Sur un vrai VPS avec domaine (ex: OVH) : pointer un enregistrement DNS A
#   vers l'IP du VPS, ouvrir les ports 80 et 443, puis renseigner :
#     DOMAIN=ton-domaine.fr
#     TLS_MODE=ton-email@example.com   (email de contact Let's Encrypt)
#   Caddy obtient et renouvelle alors le certificat automatiquement.
DOMAIN=localhost
TLS_MODE=internal
HTTP_PORT=80
HTTPS_PORT=443

# Envoi d'emails (confirmation d'adresse, changement de mot de passe,
# suppression de compte, préavis d'inactivité).
# Toutes optionnelles : sans SMTP_HOST/SMTP_USER/SMTP_PASSWORD, le service reste
# INERTE — il journalise le contenu des messages au lieu de les envoyer, ce qui
# permet de jouer et de développer sans compte mail. Mise en place détaillée :
# docs/ovh-email-setup.md.
# Le backend annonce au démarrage si le SMTP est configuré ET joignable ;
# vérifier cette ligne dans `docker compose logs backend` après tout changement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Amimot <amimot-assistance@ton-domaine.fr>

# Base publique utilisée pour construire les liens envoyés par mail. Sans elle,
# elle est dérivée de DOMAIN/HTTPS_PORT — à ne renseigner que si l'URL publique
# ne correspond pas (proxy sur un autre domaine, sous-chemin...).
APP_URL=

# Nombre de reverse proxies DEVANT le backend, pour qu'Express remonte
# X-Forwarded-For jusqu'à la vraie IP cliente. Se tromper est SILENCIEUX :
# trop peu de sauts et req.ip vaut l'IP d'un proxy, donc la même pour tout le
# monde — le limiteur d'authentification ci-dessous devient alors un budget
# global partagé par tous les visiteurs au lieu d'être par IP.
#   1 = Caddy seul (dev, ou VPS où Caddy termine le TLS)
#   2 = nginx de l'hôte termine le TLS DEVANT Caddy (déploiement actuel)
TRUST_PROXY_HOPS=1

# Plafond du limiteur d'authentification, par IP et par tranche de 10 minutes
# (inscription, connexion, mot de passe oublié, confirmation d'adresse).
# Défaut : 20. À ne relever que pour les suites de tests, pas en production.
AUTH_RATE_LIMIT_MAX=
